<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: plain black, no icon, so it hands off invisibly to the intro. -->
    <style name="Theme.RevTale" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/night</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
